{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2024", "esnext.array", "dom"],
    "moduleDetection": "force",
    "module": "preserve",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
